# --- Backend FastAPI ---
# Base URL tanpa trailing slash. Di Docker Compose gunakan nama service api.
FASTAPI_URL=http://api:8000

# Shared secret; harus sama dengan INTERNAL_API_KEY di backend.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=

# Opsional. Kosong = semua grup diproses. Pisahkan dengan koma.
# Contoh: 120363000000000000@g.us,120363111111111111@g.us
ALLOWED_GROUP_JIDS=

# --- Sesi Baileys ---
# Simpan di volume permanen agar tidak scan QR ulang saat restart.
AUTH_DIR=./auth_info_baileys

# --- Runtime ---
TZ=Asia/Makassar
LOG_LEVEL=info
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1000
REQUEST_TIMEOUT_MS=10000

# --- Control server (untuk admin web pairing QR) ---
CONTROL_HOST=0.0.0.0
CONTROL_PORT=3000
