# Admin Web E2E Test Configuration
# Copy this file to .env and fill in your test credentials

# Base URL of the running app (default: local dev server)
BASE_URL=http://localhost:55501

# Test credentials - CHANGE THESE to your actual test user accounts
E2E_ADMIN_USERNAME=admin
E2E_ADMIN_PASSWORD=admin123

E2E_SUPERVISOR_USERNAME=supervisor
E2E_SUPERVISOR_PASSWORD=super123

E2E_MANAGER_USERNAME=manager
E2E_MANAGER_PASSWORD=mgr123

E2E_SALES_USERNAME=sales
E2E_SALES_PASSWORD=sales123

# Backend API URL (if different from frontend URL)
# API_BASE_URL=http://localhost:8080

# Web server command to start the app (for local development)
# WEB_SERVER_COMMAND=cd ../build/web && python -m http.server 55501
