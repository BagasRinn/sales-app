# --- Database ---
# PostgreSQL connection string (Supabase cloud or local)
DATABASE_URL=postgresql://postgres:<PASSWORD>@<HOST>:<PORT>/<DATABASE>

# --- JWT Authentication ---
# REQUIRED. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- CORS ---
# Comma-separated list of allowed origins.
# Example: https://admin.yourdomain.com,https://sales.yourdomain.com
# REQUIRED when allow_credentials=True (which is the case here). Kalau kosong,
# backend TIDAK mengizinkan origin apa pun (bukan fallback ke "*"), jadi
# request dari web app akan diblokir browser. Isi dengan origin web app
# (skema + host, tanpa slash di akhir) di setiap environment yang memakai auth.
CORS_ORIGINS=

# --- Lingkungan ---
# Isi "production" di server produksi. Dipakai sebagai pengaman tambahan:
# SEED_DEMO_USERS akan diabaikan walau diset true.
ENVIRONMENT=development

# --- Demo Seed ---
# Set to "true" to auto-create admin/admin and sales/sales users on first boot.
# Ditolak otomatis kalau ENVIRONMENT=production.
SEED_DEMO_USERS=false

# --- Scheduler ---
# Set to "false" to disable the auto-expire background job.
# When running uvicorn with --workers N, set RUN_SCHEDULER=false on N-1 workers.
RUN_SCHEDULER=true
