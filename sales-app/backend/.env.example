# ============================================================
# Backend environment variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# --- Database ---
# PostgreSQL connection string (Supabase cloud or local)
DATABASE_URL=postgresql://postgres:<PASSWORD>@<HOST>:<PORT>/<DATABASE>

# --- JWT Authentication ---
# REQUIRED. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- CORS ---
# Comma-separated list of allowed origins.
# Example: https://admin.yourdomain.com,https://sales.yourdomain.com
# REQUIRED when allow_credentials=True (which is the case here): leaving this
# empty falls back to "*", which browsers REJECT for credentialed requests
# (i.e. any call that sends Authorization), so the web app cannot reach the API.
# Set this to your web app origin(s) in every environment that uses auth.
CORS_ORIGINS=

# --- Demo Seed ---
# Set to "true" to auto-create admin/admin and sales/sales users on first boot.
# Disable in production (use proper user registration instead).
SEED_DEMO_USERS=false

# --- Scheduler ---
# Set to "false" to disable the auto-expire background job.
# When running uvicorn with --workers N, set RUN_SCHEDULER=false on N-1 workers.
RUN_SCHEDULER=true
