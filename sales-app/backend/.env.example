# --- Database ---
# PostgreSQL connection string (Supabase cloud or local)
DATABASE_URL=postgresql://postgres:<PASSWORD>@<HOST>:<PORT>/<DATABASE>

# --- JWT Authentication ---
# REQUIRED. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- CORS ---
# Comma-separated list of allowed origins.
# Example: https://admin.yourdomain.com,https://sales.yourdomain.com
# REQUIRED when allow_credentials=True (which is the case here). Kalau kosong,
# backend TIDAK mengizinkan origin apa pun (bukan fallback ke "*"), jadi
# request dari web app akan diblokir browser. Isi dengan origin web app
# (skema + host, tanpa slash di akhir) di setiap environment yang memakai auth.
CORS_ORIGINS=

# --- Cookie sesi admin web ---
# Refresh token admin web disimpan di cookie httpOnly (bukan localStorage).
# Default mengikuti ENVIRONMENT:
#   production -> SameSite=None; Secure  (admin web & API beda domain)
#   development -> SameSite=Lax; Secure=false (http://localhost)
# CORS_ORIGINS di atas juga menjadi allowlist header Origin untuk request
# berbasis cookie, jadi origin admin web WAJIB ada di sana.
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true
# COOKIE_DOMAIN=
# COOKIE_PATH=/api/v1/auth
# REFRESH_COOKIE_NAME=admin_rt

# --- Lingkungan ---
# Isi "production" di server produksi. Dipakai sebagai pengaman tambahan:
# SEED_DEMO_USERS akan diabaikan walau diset true.
ENVIRONMENT=development

# --- Demo Seed ---
# Set to "true" to auto-create admin/admin and sales/sales users on first boot.
# Ditolak otomatis kalau ENVIRONMENT=production.
SEED_DEMO_USERS=false

# --- Scheduler ---
# Set to "false" to disable the auto-expire background job.
# When running uvicorn with --workers N, set RUN_SCHEDULER=false on N-1 workers.
RUN_SCHEDULER=true

# --- Integrasi absensi WhatsApp ---
# Shared secret yang harus sama dengan INTERNAL_API_KEY di wa-worker.
# Kalau kosong, webhook /api/v1/webhooks/wa-attendance menolak semua request (503).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=
