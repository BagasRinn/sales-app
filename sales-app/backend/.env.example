# ============================================================
# Backend environment variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# --- Database ---
# PostgreSQL connection string (Supabase cloud or local)
DATABASE_URL=postgresql://postgres:<PASSWORD>@<HOST>:<PORT>/<DATABASE>

# --- JWT Authentication ---
# REQUIRED. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Google Sheets Sync ---
# Name of the spreadsheet to sync from (must match Service Account access)
GOOGLE_SHEETS_NAME=Test-sheets

# Path to Google Service Account credentials JSON file.
# Keep this file out of version control (see .gitignore).
# GOOGLE_SHEETS_CREDENTIALS_PATH=credentials.json

# --- CORS ---
# Comma-separated list of allowed origins for production.
# Example: https://admin.yourdomain.com,https://sales.yourdomain.com
# Leave empty to allow all origins (DEV ONLY — not safe for production).
CORS_ORIGINS=

# --- Demo Seed ---
# Set to "true" to auto-create admin/admin and sales/sales users on first boot.
# Disable in production (use proper user registration instead).
SEED_DEMO_USERS=false

# --- Scheduler ---
# Set to "false" to disable the auto-expire background job.
# When running uvicorn with --workers N, set RUN_SCHEDULER=false on N-1 workers.
RUN_SCHEDULER=true
