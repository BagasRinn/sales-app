# Salin file ini menjadi .env.production, lalu isi nilainya.
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# JANGAN commit .env.production. File ini berisi password dan SECRET_KEY.

# ── Domain publik ────────────────────────────────────────────────────────────
# Tanpa https:// dan tanpa slash di akhir.
# Contoh: api.salesapp.my.id
API_DOMAIN=api.CONTOH.my.id

# ── Database ─────────────────────────────────────────────────────────────────
# Gunakan password acak tanpa karakter khusus agar aman dipakai di URL.
#   openssl rand -hex 24
POSTGRES_DB=sales
POSTGRES_USER=sales_app
POSTGRES_PASSWORD=GANTI_DENGAN_HASIL_OPENSSL_RAND_HEX_24

# Harus sama dengan POSTGRES_* di atas. Host "db" adalah nama service compose.
# Kalau password memakai karakter khusus, URL-encode dulu (mis. @ -> %40).
DATABASE_URL=postgresql+psycopg://sales_app:GANTI_DENGAN_HASIL_OPENSSL_RAND_HEX_24@db:5432/sales

# ── Aplikasi ─────────────────────────────────────────────────────────────────
# SALIN NILAI LAMA dari Railway agar semua user tidak logout.
SECRET_KEY=SALIN_DARI_RAILWAY

# Origin frontend yang diizinkan (skema + host, tanpa slash di akhir).
# Firebase Hosting saat ini:
CORS_ORIGINS=https://sales-admin-web.web.app,https://sales-order-web.web.app

ENVIRONMENT=production
SEED_DEMO_USERS=false
RUN_SCHEDULER=true

# ── Storage (opsional) ───────────────────────────────────────────────────────
# Saat ini 0 object. Isi hanya kalau fitur upload PDF bulletin masih dipakai.
# Supabase Storage tetap bisa dipakai selama Supabase belum dihapus.
# STORAGE_PROVIDER=supabase
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_SERVICE_KEY=SALIN_DARI_RAILWAY
# SUPABASE_BUCKET=bulletins

# Atau pindah ke S3/R2:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET_NAME=
# AWS_REGION=ap-southeast-1
# AWS_ENDPOINT_URL=

# ── Lain-lain (opsional) ─────────────────────────────────────────────────────
# Fallback daftar supplier kalau query DB gagal.
# SUPPLIERS_4P=
