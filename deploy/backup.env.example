# Salin menjadi backup.env kalau ingin mengatur backup dari file, bukan cron env.
#   cp backup.env.example backup.env
#   chmod 600 backup.env
#
# File ini hanya dibaca oleh backup.sh di host, tidak masuk container.

# Folder backup lokal di VPS.
BACKUP_DIR=/var/backups/sales

# Folder PDF bulletin (local storage). Default: <folder deploy>/bulletins.
# BULLETINS_DIR=/opt/sales-app/deploy/bulletins

# Hapus backup lokal yang lebih tua dari N hari.
RETENTION_DAYS=14

# Enkripsi dengan age (wajib untuk produksi).
# Buat keypair di laptop, simpan private key di password manager:
#   age-keygen -o age-key.txt
# Lalu isi public key (baris "public key: age1...") di bawah.
# AGE_RECIPIENT=age1....

# Upload offsite (opsional, ditunda untuk fase ini).
# Contoh R2: r2:sales-backup
# RCLONE_REMOTE=
